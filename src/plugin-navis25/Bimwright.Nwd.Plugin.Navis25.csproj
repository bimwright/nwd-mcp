<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Bimwright.Nwd.Plugin</RootNamespace>
    <AssemblyName>Bimwright.Nwd.Plugin.Navis25</AssemblyName>
    <Version>1.1.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NavisworksYear>2025</NavisworksYear>
    <DefineConstants>$(DefineConstants);NAVIS2025</DefineConstants>
    <!-- Navisworks API reference assemblies (Autodesk-signed) come from NuGet at compile time only:
         no Navisworks install is needed, and they are never copied to the output or the bundle. -->
    <NavisworksApiPackageVersion>2025.0.0</NavisworksApiPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Speckle.Navisworks.API" Version="$(NavisworksApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <PackageReference Include="IsExternalInit" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\shared\Plugin\NwdRibbon.xaml">
      <LogicalName>NwdRibbon.xaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
