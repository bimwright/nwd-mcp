<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bimwright.Nwd.Server</RootNamespace>
    <AssemblyName>Bimwright.Nwd.Server</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bimwright-nwd</ToolCommandName>
    <PackageId>Bimwright.Nwd.Server</PackageId>
    <Version>0.1.2</Version>
    <Authors>Khoa Le</Authors>
    <Description>MCP gateway for Autodesk Navisworks Manage 2022-2027.</Description>
    <PackageProjectUrl>https://github.com/bimwright/nwd-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bimwright/nwd-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>mcp;navisworks;bim;nwd;ai</PackageTags>
    <Copyright>Copyright 2026 Khoa Le</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Bimwright.Nwd.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\Infrastructure\NwdCommandEnvelope.cs" LinkBase="Shared\Infrastructure" />
    <Compile Include="..\shared\Infrastructure\NwdCommandResult.cs" LinkBase="Shared\Infrastructure" />
    <Compile Include="..\shared\Infrastructure\NwdCommandCatalog.cs" LinkBase="Shared\Infrastructure" />
    <Compile Include="..\shared\Infrastructure\ResponseSizeGuard.cs" LinkBase="Shared\Infrastructure" />
    <Compile Include="..\shared\Infrastructure\TargetDescriptor.cs" LinkBase="Shared\Infrastructure" />
    <Compile Include="..\shared\Infrastructure\TargetRegistry.cs" LinkBase="Shared\Infrastructure" />
    <Compile Include="..\shared\Security\SecretMasker.cs" LinkBase="Shared\Security" />
    <Compile Include="..\shared\Security\ErrorSanitizer.cs" LinkBase="Shared\Security" />
    <Compile Include="..\shared\ToolBaker\BakedToolRecord.cs" LinkBase="Shared\ToolBaker" />
    <Compile Include="..\shared\ToolBaker\BakedToolDispatchAuthorizer.cs" LinkBase="Shared\ToolBaker" />
    <Compile Include="..\shared\ToolBaker\BakedToolRuntimeCommandFactory.cs" LinkBase="Shared\ToolBaker" />
    <Compile Include="..\shared\ToolBaker\BakedToolRuntimeSource.cs" LinkBase="Shared\ToolBaker" />
    <Compile Include="..\shared\ToolBaker\BakeCompilerPolicy.cs" LinkBase="Shared\ToolBaker" />
    <Compile Include="..\shared\ToolBaker\ToolCompiler.cs" LinkBase="Shared\ToolBaker" />
    <Compile Include="..\shared\Security\BakeRedactor.cs" LinkBase="Shared\Security" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
